#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local credentials and machine-specific tooling
.env
.env.*
!.env.example
**/key.properties
**/*.jks
**/*.keystore
*.pem
*.p12
*.mobileprovision
.fvm/flutter_sdk
.codex/
.agents/

# Local captures and scratch output
/screenshots/
/tmp/

# Historical device captures stay local (may include camera images/device data)
/docs/design/**/*.png
/docs/design/**/*.jpg
/docs/design/**/*.jpeg
/docs/design/**/*.xml
/docs/design/**/*log*.txt
